<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Times New Roman', Times, serif; padding: 40px; color: #000; position: relative; }
        .header { display: flex; justify-content: space-between; align-items: flex-start; }
        .logo-area img { width: 100px; }
        .title { font-size: 60px; font-weight: normal; margin: 0; }
        .info-area { display: flex; justify-content: space-between; margin-top: 30px; font-size: 16px; }
        table { width: 100%; border-collapse: collapse; margin-top: 40px; }
        th, td { border: 1px solid #000; padding: 15px; text-align: center; font-size: 16px; }
        .desc-col { text-align: left; width: 70%; }
        .footer { margin-top: 50px; text-align: right; }
        .footer h2 { font-size: 40px; color: #e0e0e0; letter-spacing: 5px; margin-bottom: 30px; }
        .signature-line { margin-top: 50px; display: inline-block; border-top: 1px solid #000; padding-top: 5px; font-weight: bold; }
        .thanks { font-size: 30px; font-family: cursive; margin-top: 30px; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo-area">
            <img src="file://{{LOGO_PATH}}" alt="Logo">
            <p><strong>PrangArt Lab</strong></p>
        </div>
        <div class="title">Invoice</div>
    </div>

    <div class="info-area">
        <div>
            <p>Jl. Wiraguna Gang 4<br>
            Kel. Sidadadi, Samarinda<br>
            Email: prangart.studios@gmail.com<br>
            WhatsApp: 08977250597</p>
        </div>
        <div>
            <p>Tanggal: {{TANGGAL}}<br>
            Nama: {{NAMA}}</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th class="desc-col">Deskripsi</th>
                <th>Jumlah</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="desc-col" style="height: 150px; vertical-align: top;">Pelunasan Musik (Sisa)</td>
                <td style="vertical-align: top;">{{SISA}}</td>
            </tr>
            <tr>
                <td class="desc-col"><strong>Total Biaya</strong></td>
                <td><strong>{{TOTAL}}</strong></td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        <h2>PrangArt Lab</h2>
        <p>Fikri Yassaar Arrazaq</p>
        <div class="signature-line"></div>
        <div class="thanks">Terima kasih!</div>
    </div>
</body>
</html>