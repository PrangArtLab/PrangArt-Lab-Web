<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <style>
        @page { size: A4; margin: 0; }
        body { 
            font-family: 'Times New Roman', Times, serif; 
            padding: 50px 60px; 
            color: #000; 
            background: #fff;
            position: relative;
            box-sizing: border-box;
            height: 100vh;
        }

        /* Watermark Logo Besar di Tengah */
        .bg-logo { 
            position: absolute; 
            top: 35%; 
            left: 50%; 
            transform: translate(-50%, -50%); 
            width: 400px; 
            opacity: 0.08; 
            z-index: -1; 
        }

        /* Header */
        .header { display: flex; justify-content: space-between; align-items: flex-start; }
        .logo-area img { width: 100px; height: auto; }
        .logo-area p { font-weight: bold; margin-top: 5px; text-align: center; }
        .title { font-size: 64px; font-weight: normal; margin: 0; }
        
        /* Info Alamat & Tanggal */
        .info-area { display: flex; justify-content: space-between; margin-top: 20px; font-size: 16px; line-height: 1.4; }
        .info-right { text-align: left; margin-right: 50px; }
        
        /* Tabel */
        table { width: 100%; border-collapse: collapse; margin-top: 40px; }
        th, td { border: 1.5px solid #000; padding: 15px; text-align: center; font-size: 16px; }
        .desc-col { text-align: left; width: 65%; }
        .row-height { height: 180px; vertical-align: top; }
        
        /* Footer Tanda Tangan */
        .footer { margin-top: 50px; text-align: right; position: relative; }
        .footer h2 { font-size: 40px; color: #e0e0e0; letter-spacing: 8px; margin-bottom: 40px; }
        .signature-line { 
            margin-top: 60px; 
            display: inline-block; 
            border-top: 1px solid #000; 
            padding-top: 5px; 
            font-weight: bold; 
            width: 250px;
        }
        .thanks { 
            font-size: 36px; 
            font-family: 'Brush Script MT', cursive; 
            margin-top: 30px; 
            margin-right: 20px;
        }
    </style>
</head>
<body>
    <!-- Watermark Logo di Tengah -->
    <img src="file://{{LOGO_PATH}}" class="bg-logo" alt="Watermark">

    <!-- Header -->
    <div class="header">
        <div class="logo-area">
            <img src="file://{{LOGO_PATH}}" alt="Logo PrangArt">
            <p>PrangArt Lab</p>
        </div>
        <div class="title">Invoice</div>
    </div>

    <!-- Info -->
    <div class="info-area">
        <div>
            Jl. Wiraguna Gang 4<br>
            Kel. Sidadadi, Samarinda<br>
            Email: prangart.studios@gmail.com<br>
            WhatsApp: 08977250597
        </div>
        <div class="info-right">
            Tanggal: {{TANGGAL}}<br>
            Nama: {{NAMA}}
        </div>
    </div>

    <!-- Tabel -->
    <table>
        <thead>
            <tr>
                <th class="desc-col">Deskripsi</th>
                <th>Jumlah</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="desc-col row-height">Pelunasan Musik</td>
                <td class="row-height">{{SISA}}</td>
            </tr>
            <tr>
                <td class="desc-col"><strong>Total</strong></td>
                <td><strong>{{TOTAL}}</strong></td>
            </tr>
        </tbody>
    </table>

    <!-- Footer -->
    <div class="footer">
        <h2>PrangArt Lab</h2>
        <p>Fikri Yassaar Arrazaq</p>
        <div class="signature-line"></div>
        <div class="thanks">Terima kasih!</div>
    </div>
</body>
</html>
