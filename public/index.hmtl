<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light"> <!-- Mencegah Dark Mode merusak tampilan -->
    <title>Formulir Pemesanan - PrangArt Studios</title>
    <!-- Menggunakan font modern dari Google -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="form-container">
        <div class="header-form">
            <h1>PrangArt Studios</h1>
            <p>Formulir Pemesanan Produksi Musik Tari</p>
            <div id="progress-bar">Bagian 1 dari 4</div>
        </div>

        <form id="orderForm">
            <!-- SECTION 1: PEMBUKA -->
            <div class="form-step active" id="step-1">
                <h3>Selamat Datang</h3>
                <p class="desc-text">Apakah Anda tertarik/membawa proses produksi musik Anda menggunakan karya tari sama dengan PrangArt Studios?</p>
                
                <div class="radio-group">
                    <label class="custom-radio">
                        <input type="radio" name="tertarik" value="Ya" required onchange="toggleSection('ya')"> 
                        <span class="checkmark"></span> Ya, Tertarik
                    </label>
                    <label class="custom-radio">
                        <input type="radio" name="tertarik" value="Tidak" onchange="toggleSection('tidak')"> 
                        <span class="checkmark"></span> Tidak
                    </label>
                </div>
                
                <div id="pesan-tidak" style="display:none; color:#d32f2f; margin-top:15px; font-weight:500;">
                    Terima kasih atas waktunya. Formulir berhenti di sini.
                </div>

                <div class="btn-group" id="btn-step1" style="display:none;">
                    <button type="button" class="next-btn" onclick="validateAndNext(2)">Lanjut</button>
                </div>
            </div>

            <!-- SECTION 2: DATA DIRI & KARYA -->
            <div class="form-step" id="step-2" style="display:none;">
                <h3>Data Pemesan & Karya</h3>
                
                <div class="input-group">
                    <label>Nama Lengkap *</label>
                    <input type="text" id="nama" placeholder="Masukkan nama lengkap" required>
                </div>

                <div class="input-group">
                    <label>Nama Sanggar / Komunitas / Instansi</label>
                    <input type="text" id="sanggar" placeholder="Opsional">
                </div>

                <div class="input-group">
                    <label>Kota / Provinsi *</label>
                    <input type="text" id="kota" placeholder="Contoh: Samarinda" required>
                </div>

                <div class="input-group">
                    <label>Nomor WhatsApp Aktif *</label>
                    <input type="tel" id="wa" placeholder="08xxxxxxxxxx" required>
                </div>

                <div class="input-group">
                    <label>Email *</label>
                    <input type="email" id="email" placeholder="email@contoh.com" required>
                </div>

                <div class="input-group">
                    <label>Nama lengkap koreografer</label>
                    <input type="text" id="koreografer" placeholder="Opsional">
                </div>

                <div class="input-group">
                    <label>Judul Tari / Nama Karya *</label>
                    <input type="text" id="judul" placeholder="Masukkan judul karya" required>
                </div>

                <div class="input-group">
                    <label>Jenis Tari *</label>
                    <select id="jenisTari" required>
                        <option value="">-- Pilih Jenis Tari --</option>
                        <option value="Tari Tradisional Kreasi">Tari Tradisional Kreasi</option>
                        <option value="Tari Modern">Tari Modern</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="input-group">
                    <label>Latar Belakang Budaya / Daerah *</label>
                    <input type="text" id="latarBudaya" placeholder="Contoh: Melayu, Dayak, Modern" required>
                </div>

                <div class="input-group">
                    <label>Sinopsis *</label>
                    <textarea id="sinopsis" rows="3" placeholder="Ceritakan sinopsis tari..." required></textarea>
                </div>

                <div class="input-group">
                    <label>Referensi Musik Link (YouTube/Video)</label>
                    <input type="text" id="referensi" placeholder="Kosongkan atau isi '0' jika tidak ada">
                </div>

                <div class="input-group">
                    <label>Estimasi durasi tari *</label>
                    <input type="text" id="durasi" placeholder="Contoh: 5 Menit" required>
                </div>

                <div class="input-group">
                    <label>Paket yang dipilih *</label>
                    <select id="paket" required onchange="handlePaketChange()">
                        <option value="">-- Pilih Paket --</option>
                        <option value="Paket Dasar">Paket Dasar</option>
                        <option value="Paket Pro">Paket Pro</option>
                        <option value="Paket Standar">Paket Standar</option>
                    </select>
                </div>

                <div class="btn-group">
                    <button type="button" class="prev-btn" onclick="prevStep(1)">Kembali</button>
                    <button type="button" class="next-btn" id="btn-lanjut-step2" onclick="validateAndNext('pembayaran')">Lanjut</button>
                </div>
            </div>

            <!-- SECTION 3: PAKET DASAR -->
            <div class="form-step" id="step-paket-dasar" style="display:none;">
                <h3>Detail Paket Dasar</h3>
                
                <div class="input-group">
                    <label>Tempo *</label>
                    <input type="text" class="paket-input dasar" required placeholder="Contoh: 80 BPM">
                </div>

                <div class="input-group">
                    <label>Nuansa Musik yang di inginkan *</label>
                    <select class="paket-input dasar" required>
                        <option value="Sakral / Ritual">Sakral / Ritual</option>
                        <option value="Ceria / Riang">Ceria / Riang</option>
                        <option value="Dramatis">Dramatis</option>
                        <option value="Mistis">Mistis</option>
                    </select>
                </div>

                <div class="input-group">
                    <label>Rekomendasi instrumen utama (maksimal 5)</label>
                    <textarea class="paket-input dasar" rows="2" placeholder="Contoh: Gendang, Sape, Suling"></textarea>
                </div>

                <div class="input-group">
                    <label>Penambahan vokal paket dasar *</label>
                    <div class="radio-group">
                        <label class="custom-radio"><input type="radio" name="vokalDasar" value="Sokalan atau terkait ata" class="paket-input dasar" required><span class="checkmark"></span> Sokalan / Terkait</label>
                        <label class="custom-radio"><input type="radio" name="vokalDasar" value="Hanya nyanyian lagi"><span class="checkmark"></span> Hanya nyanyian</label>
                        <label class="custom-radio"><input type="radio" name="vokalDasar" value="Nyanyian lagi dan sokalan"><span class="checkmark"></span> Nyanyian & Sokalan</label>
                        <label class="custom-radio"><input type="radio" name="vokalDasar" value="Tidak menggunakan"><span class="checkmark"></span> Tidak menggunakan</label>
                    </div>
                </div>

                <div class="btn-group">
                    <button type="button" class="prev-btn" onclick="prevStep(2)">Kembali</button>
                    <button type="button" class="next-btn" onclick="validateAndNext('pembayaran')">Lanjut</button>
                </div>
            </div>

            <!-- SECTION 4: PAKET PRO -->
            <div class="form-step" id="step-paket-pro" style="display:none;">
                <h3>Detail Paket Pro</h3>
                
                <div class="input-group">
                    <label>Penambahan vokal paket pro *</label>
                    <div class="radio-group">
                        <label class="custom-radio"><input type="radio" name="vokalPro" value="Sokalan atau terkait ata" class="paket-input pro" required><span class="checkmark"></span> Sokalan / Terkait</label>
                        <label class="custom-radio"><input type="radio" name="vokalPro" value="Hanya nyanyian lagi"><span class="checkmark"></span> Hanya nyanyian</label>
                        <label class="custom-radio"><input type="radio" name="vokalPro" value="Nyanyian lagi dan sokalan"><span class="checkmark"></span> Nyanyian & Sokalan</label>
                        <label class="custom-radio"><input type="radio" name="vokalPro" value="Tidak menggunakan"><span class="checkmark"></span> Tidak menggunakan</label>
                    </div>
                </div>

                <div class="input-group">
                    <label>Jelaskan urutan nuansa musik *</label>
                    <textarea class="paket-input pro" rows="4" placeholder="Contoh: 0:00 - 0:30 (Mistis), 0:30 - 1:00 (Tegang)" required></textarea>
                </div>

                <div class="input-group">
                    <label>Tautan video tari (Google Drive) *</label>
                    <textarea class="paket-input pro" rows="2" placeholder="Tempelkan link di sini" required></textarea>
                </div>

                <div class="btn-group">
                    <button type="button" class="prev-btn" onclick="prevStep(2)">Kembali</button>
                    <button type="button" class="next-btn" onclick="validateAndNext('pembayaran')">Lanjut</button>
                </div>
            </div>

            <!-- SECTION 5: PAKET STANDAR -->
            <div class="form-step" id="step-paket-standar" style="display:none;">
                <h3>Detail Paket Standar</h3>
                
                <div class="input-group">
                    <label>Penambahan vokal paket standar *</label>
                    <div class="radio-group">
                        <label class="custom-radio"><input type="radio" name="vokalStandar" value="Sokalan atau terkait ata" class="paket-input standar" required><span class="checkmark"></span> Sokalan / Terkait</label>
                        <label class="custom-radio"><input type="radio" name="vokalStandar" value="Hanya nyanyian lagi"><span class="checkmark"></span> Hanya nyanyian</label>
                        <label class="custom-radio"><input type="radio" name="vokalStandar" value="Nyanyian lagi dan sokalan"><span class="checkmark"></span> Nyanyian & Sokalan</label>
                        <label class="custom-radio"><input type="radio" name="vokalStandar" value="Tidak menggunakan"><span class="checkmark"></span> Tidak menggunakan</label>
                    </div>
                </div>

                <div class="input-group">
                    <label>Struktur Tari *</label>
                    <select class="paket-input standar" required>
                        <option value="Opening">Opening</option>
                        <option value="Orientasi/Gubahan Cerita">Orientasi/Gubahan Cerita</option>
                        <option value="Bagian Tengah">Bagian Tengah</option>
                        <option value="Klimaks">Klimaks</option>
                        <option value="Ending">Ending</option>
                    </select>
                </div>

                <div class="input-group">
                    <label>Jelaskan urutan nuansa musik *</label>
                    <textarea class="paket-input standar" rows="4" placeholder="Jelaskan detail per bagian..." required></textarea>
                </div>

                <div class="input-group">
                    <label>Tautan video tari (Google Drive) *</label>
                    <textarea class="paket-input standar" rows="2" placeholder="Tempelkan link di sini" required></textarea>
                </div>

                <div class="btn-group">
                    <button type="button" class="prev-btn" onclick="prevStep(2)">Kembali</button>
                    <button type="button" class="next-btn" onclick="validateAndNext('pembayaran')">Lanjut</button>
                </div>
            </div>

            <!-- SECTION 6: PEMBAYARAN -->
            <div class="form-step" id="step-pembayaran" style="display:none;">
                <h3>Pembayaran & Konfirmasi</h3>
                
                <div class="input-group">
                    <label>Tulis Jumlah Keterbatasan (Total Biaya) *</label>
                    <input type="text" id="total" placeholder="Contoh: 2000000" required>
                </div>

                <div class="input-group">
                    <label>Tulis jumlah terbilang (Total) *</label>
                    <input type="text" id="totalTerbilang" placeholder="Contoh: Dua Juta Rupiah" required>
                </div>

                <div class="input-group">
                    <label>Tulis Jumlah DP *</label>
                    <input type="text" id="dp" placeholder="Contoh: 1000000" required>
                </div>

                <div class="input-group">
                    <label>Tulis jumlah DP terbilang *</label>
                    <input type="text" id="dpTerbilang" placeholder="Contoh: Satu Juta Rupiah" required>
                </div>

                <div class="input-group">
                    <label>Unggah bukti transfer DP *</label>
                    <input type="file" id="buktiTransfer" accept="image/*,application/pdf" required>
                    <small style="color: #888; font-size: 12px; margin-top: 5px; display: block;">Format Gambar atau PDF (Maks. 5MB)</small>
                </div>

                <div class="checkbox-group">
                    <label class="custom-checkbox">
                        <input type="checkbox" id="pernyataan" required>
                        <span class="checkmark-box"></span>
                        <span class="checkbox-text">Saya menyatakan bahwa seluruh data yang saya isi adalah benar dan dapat dipertanggungjawabkan.</span>
                    </label>
                </div>

                <div class="btn-group">
                    <button type="button" class="prev-btn" onclick="prevStep(2)">Kembali</button>
                    <button type="submit" class="submit-btn">Kirim Formulir</button>
                </div>
            </div>
        </form>
    </div>

    <script src="script.js"></script>
</body>
</html>
